{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "运行当前文件",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "闭环：电解液 3 轮",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "program": "${workspaceFolder}/run_campaign.py",
      "args": ["--profile", "electrolyte", "--optimizer", "bayes", "--rounds", "3"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "网页前端",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "module": "streamlit",
      "args": [
        "run", "app.py",
        "--server.showEmailPrompt", "false",
        "--server.headless", "false",
        "--server.address", "127.0.0.1",
        "--browser.gatherUsageStats", "false"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
